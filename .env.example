# Base64-encoded secret whose decoded value is at least 32 bytes.
JWT_SECRET=

# Base64-encoded secret whose decoded value is at least 32 bytes (JWT_SECRET과 별도 키 사용 권장).
EMAIL_CODE_SECRET=

# 이메일 인증코드 발송용 SMTP 계정. 비워두면 로컬 기본값(localhost:587, 인증 없음)으로 시도해 실패한다 —
# 회원가입 이메일 인증 기능을 실제로 쓰려면 필수.
MAIL_USERNAME=
MAIL_PASSWORD=

# OAuth 로그인 성공 후 리다이렉트할 프론트엔드 주소. 실배포 시 https://실제도메인 으로 설정(안 하면 localhost:3000으로 리다이렉트됨).
APP_FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
AWS_S3_BASE_URL=

# Postgres. 로컬 docker-compose 기본값은 코드에 들어있지만, 실배포 시 반드시 실제 값으로 교체할 것.
POSTGRES_DB=honor_citizen
POSTGRES_USER=honor_citizen
POSTGRES_PASSWORD=
