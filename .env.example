# Base64-encoded secret whose decoded value is at least 32 bytes.
JWT_SECRET=

# Base64-encoded secret whose decoded value is at least 32 bytes (JWT_SECRET과 별도 키 사용 권장).
EMAIL_CODE_SECRET=

# 이메일 인증코드 발송용 SMTP 계정. MAIL_HOST를 안 채우면 localhost:587로 시도해 실패한다 —
# 회원가입 이메일 인증 기능을 실제로 쓰려면 4개 다 필수.
# 예: 네이버 메일 → smtp.naver.com / 587, 지메일 → smtp.gmail.com / 587(앱 비밀번호 필요)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# 발신자 주소 — 대부분의 SMTP 서버가 MAIL_USERNAME과 다른 도메인이면 발송을 거절한다.
# MAIL_USERNAME과 동일한 계정으로 채우는 게 안전하다.
MAIL_FROM=

# OAuth 로그인 성공 후 리다이렉트할 프론트엔드 주소. 실배포 시 https://실제도메인 으로 설정(안 하면 localhost:3000으로 리다이렉트됨).
APP_FRONTEND_URL=http://localhost:3000
# OAuth 완료 후 리다이렉트를 허용할 origin 목록(콤마 구분).
# 운영 예: https://name.hanse.kr,https://hanse.kr
APP_FRONTEND_ALLOWED_ORIGINS=http://localhost:3000

# HTTPS 도메인 배포 시 반드시 true로 설정(안 하면 로그인 쿠키가 브라우저에 저장되지 않음).
# 로컬 docker-compose 기본값은 false(HTTP 개발 환경 전용).
COOKIE_SECURE=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
AWS_S3_BASE_URL=

# Postgres. 로컬 docker-compose 기본값은 코드에 들어있지만, 실배포 시 반드시 실제 값으로 교체할 것.
POSTGRES_DB=honor_citizen
POSTGRES_USER=honor_citizen
POSTGRES_PASSWORD=
